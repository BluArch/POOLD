NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://poold:poold_local_only@127.0.0.1:3308/poold_dev
TEST_DATABASE_URL=mysql://poold:poold_local_only@127.0.0.1:3308/poold_test
APP_ORIGIN=http://localhost:8081
PUBLIC_APP_URL=http://localhost:8081
DEMO_ENABLED=true
REQUEST_INTEREST_TARGET=3
EMAIL_OUTBOX=../../.local/mail-outbox.jsonl
# Gmail SMTP: enable Google 2-Step Verification and generate an app password.
# Fill these to send emails; leave blank for the local development outbox.
# Gmail host: smtp.gmail.com; user: your-sender@gmail.com; password: Google App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional for Gmail; defaults to POOLD <SMTP_USER>.
SMTP_FROM=
# Alternative to the host/user/pass settings above (requires SMTP_FROM):
# SMTP_URL=smtps://user:password@smtp.example.com:465
# Required in production: generate with the command below and keep it server-only.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
# Development automatically persists a private key in .local/otp-secret if unset.
# Never put SMTP/OTP/FCM secrets in EXPO_PUBLIC variables.
# FCM_ENABLED=true
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
# Firebase native files are configured in apps/mobile/app.config.ts.
