# iOS simulator / browser. For Android emulator use http://10.0.2.2:4000.
# For physical devices use the computer's LAN IP; run only on a trusted network.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
# To connect a native Expo build to the hosted service, use:
# EXPO_PUBLIC_API_URL=https://poold.onrender.com/api
EXPO_PUBLIC_FCM_ENABLED=false
# Stripe publishable key (pk_test_... for local development; safe for the client).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Expose the sandbox-only hold preview and hosted Checkout in development builds.
EXPO_PUBLIC_PAYMENTS_TEST_MODE=false
# Android native Firebase file (not a server credential):
# GOOGLE_SERVICES_JSON=/absolute/path/google-services.json

# iOS native Firebase file; APNs credentials also required in the Firebase console.
# GOOGLE_SERVICES_PLIST=/absolute/path/GoogleService-Info.plist
